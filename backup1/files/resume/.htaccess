# Security: Disable PHP script execution inside resume uploads folder
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|exe)$">
        Require all denied
    </FilesMatch>
</IfModule>
